{
    "$schema": "./.ticbuild/ticbuild.schema.json",
    "project": {
        "name": "space_logistics",
        "importDirs": [
            "assets"
        ],
        "includeDirs": [
            "src"
        ],
        "binDir": "./build/$(buildConfiguration)-bin",
        "objDir": "./build/$(buildConfiguration)-obj",
        "outputCartName": "$(project.name).tic"
    },
    "imports": [
        {
            "name": "song",
            "path": "music/Space Logistics.tic"
        },
        {
            "name": "maincode",
            "path": "source/main.lua"
        }
    ],
    "assembly": {
        "blocks": [
            {
                "asset": "song",
                "chunks": ["MUSIC_PATTERNS", "MUSIC_TRACKS", "WAVEFORMS", "SFX"]
            },
            {
                "asset": "maincode",
                //"chunks": ["CODE_COMPRESSED"]
                "chunks": ["CODE"]
            }
        ],
        "lua": {
            "minify": false
        }
    },
    "buildConfigurations": {
        "debug": {
            "defines": [
                "DEBUG"
            ]
        },
        "release": {
            "defines": [
                "RELEASE"
            ],
            "assembly": {
                "lua": {
                    "minify": true
                }
            }
        }
    }
}